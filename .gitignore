# Python
__pycache__/
.pytest_cache/
*.pyc

# Secrets / env
.env
.env.*
!.env.example

# Editor / IDE scratch
.cursor/
.vscode/*
!.vscode/settings.json
*~
*.swp
*.tmp
docs/Untitled
docs/Untitled.*

# Local config backups (scripts/lib/common.sh)
backups/

# Local Python environments
.venv*/
.venv-e2e/

# Playwright browser cache (e2e)
.playwright/

# Study/vendor trees belong under ~/eai-build — not in amdeai root
clusterforge/

# Bloom runtime config/logs (join tokens, machine-local)
additional_node_command.txt
bloom.yaml
.bloom/
bloom.log
bloom-*.log
bloom-playbook/
bloom

# Local archives / exports (not source)
*.tar.gz
*.tgz
*.zip

# Graphify — fully local; regenerated by `graphify update` and commit hooks
graphify-out/

# Perf diagnostics — ephemeral GPU load captures (kernel logs, mem timelines, predictor dumps)
tests/perf/diag/

# Perf run artifacts — commit structured results.json only (see tests/perf/baselines/)
tests/perf/runs/**/*
!tests/perf/runs/**/
!tests/perf/runs/**/results.json
