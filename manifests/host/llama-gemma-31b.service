# systemd user unit — Gemma 4 31B on port 8081 (HIP).
# Install: cp to ~/.config/systemd/user/llama-gemma-31b.service, edit paths if needed.
# Enable:  systemctl --user daemon-reload && systemctl --user enable --now llama-gemma-31b.service
[Unit]
Description=llama.cpp server (Gemma 4 31B) — HIP backend
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/eai-build/llama.cpp
Environment=HSA_OVERRIDE_GFX_VERSION=11.5.1
Environment=HSA_ENABLE_SDMA=0
Environment=MIOPEN_FIND_ENFORCE=1
ExecStart=%h/eai-build/llama.cpp/build-hip/bin/llama-server \
  --model %h/models/gemma-4-31b-it-Q4_K_M.gguf \
  --n-gpu-layers 999 \
  --ctx-size 32768 \
  --flash-attn on \
  --host 0.0.0.0 \
  --port 8081 \
  --jinja \
  --cache-type-k q8_0 \
  --cache-type-v q8_0
Restart=on-failure

[Install]
WantedBy=default.target
