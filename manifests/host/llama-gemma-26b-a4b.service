# systemd user unit — Gemma 4 26B-A4B on port 8080 (HIP).
# Install: mkdir -p ~/.config/systemd/user && cp this file there, then edit paths.
# Enable:  systemctl --user daemon-reload && systemctl --user enable --now llama-gemma.service
[Unit]
Description=llama.cpp server (Gemma 4 26B-A4B) — HIP backend
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/eai-build/llama.cpp
Environment=HSA_OVERRIDE_GFX_VERSION=11.5.1
Environment=HSA_ENABLE_SDMA=0
Environment=MIOPEN_FIND_ENFORCE=1
Environment=PYTORCH_TUNABLEOP_ENABLED=1
Environment=TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1
ExecStart=%h/eai-build/llama.cpp/build-hip/bin/llama-server \
  --model %h/models/gemma-4-26b-a4b-it-Q4_K_M.gguf \
  --n-gpu-layers 999 \
  --ctx-size 32768 \
  --flash-attn \
  --host 0.0.0.0 \
  --port 8080 \
  --jinja \
  --cache-type-k q8_0 \
  --cache-type-v q8_0
Restart=on-failure

[Install]
WantedBy=default.target
